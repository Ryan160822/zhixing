[Unit]
Description=ZXGK mobile web query service
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=zxgk
Group=zxgk
WorkingDirectory=/opt/zxgk-query
Environment=ZXGK_HOST=127.0.0.1
Environment=ZXGK_PORT=8765
ExecStart=/opt/zxgk-query/.venv/bin/python /opt/zxgk-query/run_mobile.py
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
